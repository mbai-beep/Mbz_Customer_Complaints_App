{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/*.js": { "memory": 512, "maxDuration": 30 } },
  "headers": [
    { "source": "/api/image", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }] }
  ]
}
